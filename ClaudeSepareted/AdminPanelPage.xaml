<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ClaudeSepareted.AdminPanelPage"
             Title="Admin Panel">

	<VerticalStackLayout Padding="20" Spacing="15">
		<Label Text="Válassz sebességet:" />
		<Picker x:Name="SpeedPicker" />

		<Label Text="Válassz vonatot:" />
		<Picker x:Name="TrainPicker" ItemDisplayBinding="{Binding Name}" />

		<Button Text="Start" Clicked="OnStartClicked" />
	</VerticalStackLayout>
</ContentPage>