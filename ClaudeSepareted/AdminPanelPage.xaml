<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ClaudeSepareted.AdminPanelPage"
             Title="System Status Monitor">

    <Frame BackgroundColor="#1E1E1E" Padding="15" CornerRadius="0" HasShadow="False">
        <Grid RowDefinitions="Auto, *, Auto">
            <Label Grid.Row="0"
                   Text="SYSTEM EVENT LOG"
                   FontAttributes="Bold"
                   FontSize="16"
                   TextColor="White"
                   Margin="0,0,0,10" />

            <ScrollView Grid.Row="1" VerticalScrollBarVisibility="Always">
                <VerticalStackLayout x:Name="StatusMessagesStack" Spacing="4">
                    </VerticalStackLayout>
            </ScrollView>

            <HorizontalStackLayout Grid.Row="2" Spacing="10" HorizontalOptions="Center" Margin="0, 10, 0, 10">
                <Button Text="Éjféli Reset (Alaphelyzet)"
                        Clicked="OnForceMidnightResetClicked"
                        BackgroundColor="#D32F2F"
                        TextColor="White"/>

                <Button Text="Útvonal Cache Újraépítése"
                        Clicked="OnRebuildCacheClicked"
                        BackgroundColor="#1976D2"
                        TextColor="White"/>
            </HorizontalStackLayout>
        </Grid>
    </Frame>
</ContentPage>
