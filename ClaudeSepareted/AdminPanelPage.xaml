<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ClaudeSepareted.AdminPanelPage"
             Title="Admin Panel">

	<Grid RowDefinitions="Auto, *, Auto">
		<!-- Main content area -->
		<VerticalStackLayout Grid.Row="0" Padding="20" Spacing="15">
			<Label Text="Válassz vonatot:" />
			<Picker x:Name="TrainPicker" ItemDisplayBinding="{Binding Name}" />

			<Label Text="Válassz sebességet:" />
			<Picker x:Name="SpeedPicker" />

			<Label Text="Válassz irányt:" />
			<Picker x:Name="DirectionPicker" />

			<Button Text="Start" Clicked="OnStartClicked" />
		</VerticalStackLayout>

		<!-- Scrollable Status Bar at the bottom -->
		<Frame Grid.Row="2" BackgroundColor="LightGray" Padding="10" CornerRadius="5" HeightRequest="150">
			<Grid RowDefinitions="Auto, *">
				<!-- Status header -->
				<Label Grid.Row="0" Text="Státusz üzenetek:" FontAttributes="Bold" FontSize="14" TextColor="Black" />

				<!-- Scrollable status messages -->
				<ScrollView Grid.Row="1" VerticalScrollBarVisibility="Default">
					<VerticalStackLayout x:Name="StatusMessagesStack" Spacing="2">
						<!-- Status messages will be added here programmatically -->
					</VerticalStackLayout>
				</ScrollView>
			</Grid>
		</Frame>
	</Grid>
</ContentPage>