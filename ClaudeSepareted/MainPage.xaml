<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ClaudeSepareted.MainPage"
             Title="Vonat Menetrend"
             x:Name="ThisPage">

    <Grid ColumnDefinitions="*,Auto">
        <!-- Bal oldali fő tartalom -->
        <Grid Grid.Column="0" RowDefinitions="Auto,*" Padding="20" RowSpacing="15">

            <!-- Felső fix rész (választók + idő) -->
            <VerticalStackLayout Grid.Row="0" Spacing="15">

                <!-- Vonat kiválasztása -->
                <Picker x:Name="TrainPicker" 
                        Title="Válassz vonatot"
                        ItemDisplayBinding="{Binding Name}"
                        SelectedItem="{Binding SelectedTrain}"
                        ItemsSource="{Binding Trains}">
                </Picker>

                <!-- Kiinduló állomás/peron -->
                <Picker x:Name="StartPicker"
                        Title="Válassz indulási peront"
                        ItemDisplayBinding="{Binding DisplayName}"
                        SelectedItem="{Binding SelectedStartPlatform}"
                        ItemsSource="{Binding Platforms}">
                </Picker>

                <!-- Végállomás/peron -->
                <Picker x:Name="EndPicker"
                        Title="Válassz cél peront"
                        ItemDisplayBinding="{Binding DisplayName}"
                        SelectedItem="{Binding SelectedEndPlatform}"
                        ItemsSource="{Binding Platforms}">
                </Picker>

                <!-- Idők egymás mellett -->
                <Grid ColumnDefinitions="*,*">
                    <VerticalStackLayout Grid.Column="0" Spacing="5">
                        <Label Text="Indulási idő:" FontSize="16" />
                        <TimePicker x:Name="StartTimePicker" Time="00:00:00" Format="HH:mm" />
                    </VerticalStackLayout>
                </Grid>

            </VerticalStackLayout>

            <!-- Görgethető menetrend lista -->
            <CollectionView Grid.Row="1"
                        x:Name="ScheduleCollection"
                        ItemsSource="{Binding ScheduleItems}">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Grid ColumnDefinitions="100,*,40" HeightRequest="60" Padding="5">

                            <!-- Bal oldalt vonat neve -->
                            <Label Grid.Column="0"
                                   Text="{Binding TrainName}"
                                   VerticalOptions="Center"
                                   HorizontalOptions="Start"
                                   FontSize="14" />

                            <!-- Középen grafikus idővonal -->
                            <GraphicsView Grid.Column="1"
                                          Drawable="{Binding Drawable}"
                                          HeightRequest="60"
                                          HorizontalOptions="Fill"
                                          VerticalOptions="Center" />

                            <!-- Jobb oldalt kuka gomb -->
                            <Button Grid.Column="2"
                                    Padding="5"
                                    Text="🗑️"
                                    FontSize="18"
                                    BackgroundColor="Transparent"
                                    VerticalOptions="Center"
                                    Clicked="OnDeleteClicked" />
                        </Grid>
                    </DataTemplate>
                </CollectionView.ItemTemplate>

            </CollectionView>
        </Grid>

        <!-- Jobb oldali fix sáv -->
        <Grid Grid.Column="1"
          BackgroundColor="#E0E0E0"
          Padding="10">
            <ScrollView VerticalOptions="Fill">
                <VerticalStackLayout Spacing="15"
                                 HorizontalOptions="Center">

                    <!-- Virtual Clock Section -->
                    <Frame BackgroundColor="White"
                           CornerRadius="10"
                           Padding="15"
                           HasShadow="True">
                        <VerticalStackLayout Spacing="10">
                            <Label Text="⏰ Virtual Clock"
                                   FontSize="16"
                                   FontAttributes="Bold"
                                   HorizontalOptions="Center" />

                            <Label Text="{Binding VirtualClock.CurrentTimeString}"
                                   FontSize="20"
                                   FontAttributes="Bold"
                                   HorizontalOptions="Center"
                                   TextColor="#2196F3" />

                            <Label Text="{Binding VirtualClock.SpeedDisplay}"
                                   FontSize="14"
                                   HorizontalOptions="Center"
                                   TextColor="#666" />
                        </VerticalStackLayout>
                    </Frame>

                    <!-- Time Controls -->
                    <Frame BackgroundColor="White"
                           CornerRadius="10"
                           Padding="15"
                           HasShadow="True">
                        <VerticalStackLayout Spacing="10">
                            <Label Text="Set Time"
                                   FontSize="14"
                                   FontAttributes="Bold"
                                   HorizontalOptions="Center" />

                            <Grid ColumnDefinitions="*,*,*" ColumnSpacing="5">
                                <Entry Grid.Column="0"
                                       x:Name="HourEntry"
                                       Placeholder="HH"
                                       Keyboard="Numeric"
                                       HorizontalTextAlignment="Center" />
                                <Label Grid.Column="1"
                                       Text=":"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center"
                                       FontSize="18" />
                                <Entry Grid.Column="2"
                                       x:Name="MinuteEntry"
                                       Placeholder="MM"
                                       Keyboard="Numeric"
                                       HorizontalTextAlignment="Center" />
                            </Grid>

                            <Button Text="Set Time"
                                    Clicked="OnSetVirtualTime"
                                    BackgroundColor="#4CAF50"
                                    TextColor="White" />
                        </VerticalStackLayout>
                    </Frame>

                    <!-- Speed Controls -->
                    <Frame BackgroundColor="White"
                           CornerRadius="10"
                           Padding="15"
                           HasShadow="True">
                        <VerticalStackLayout Spacing="10">
                            <Label Text="Speed Control"
                                   FontSize="14"
                                   FontAttributes="Bold"
                                   HorizontalOptions="Center" />

                            <Picker x:Name="SpeedPicker"
                                    SelectedItem="{Binding VirtualClock.SelectedSpeedOption}"
                                    ItemsSource="{Binding VirtualClock.SpeedOptions}" />

                            <Grid ColumnDefinitions="*,*" ColumnSpacing="5">
                                <Button Grid.Column="0"
                                        Text="⏸️"
                                        Clicked="OnPauseClock"
                                        BackgroundColor="#FF9800"
                                        TextColor="White" />
                                <Button Grid.Column="1"
                                        Text="▶️"
                                        Clicked="OnResumeClock"
                                        BackgroundColor="#4CAF50"
                                        TextColor="White" />
                            </Grid>

                            <Button Text="🔄 Reset"
                                    Clicked="OnResetClock"
                                    BackgroundColor="#9E9E9E"
                                    TextColor="White" />
                        </VerticalStackLayout>
                    </Frame>

                    <!-- Action Buttons -->
                    <VerticalStackLayout Spacing="20"
                                     VerticalOptions="End"
                                     HorizontalOptions="Center">
                        <!-- Hozzáad gomb -->
                        <Frame Padding="0"
                           WidthRequest="60"
                           HeightRequest="60"
                           CornerRadius="30"
                           BackgroundColor="#FF9800"
                           HasShadow="True">
                            <Button Text="➕"
                                FontSize="24"
                                BackgroundColor="Transparent"
                                TextColor="White"
                                Clicked="OnAddClicked"/>
                        </Frame>
                    </VerticalStackLayout>

                </VerticalStackLayout>
            </ScrollView>
        </Grid>
    </Grid>

</ContentPage>